{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vera",
  "version": "2.6.0",
  "identifier": "fr.vera.personal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vera",
        "create": false,
        "width": 1280,
        "height": 860,
        "decorations": false,
        "shadow": true,
        "minWidth": 640,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; frame-src 'self' blob:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExREE4NTVBNTQ3OTlENTQKUldSVW5YbFVXb1hhb1FSS0MvYTZhNExkdytqek4yR09CVldzOGE0VzZZMEZTd3JKcHV2LzhvSkEK",
      "endpoints": [
        "https://github.com/aketaff-droid/vera-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
